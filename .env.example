# Bind address. Defaults to 127.0.0.1 (loopback). Binding a non-loopback host
# (e.g. 0.0.0.0) with no APP_AUTH_TOKEN is refused at startup unless
# APP_ALLOW_INSECURE_BIND=true — session data is served unauthenticated.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_JSON_LOGS=
# Shared secret. Empty → API is open. Set → required on /api/sessions.
# Sent as X-API-Key or Authorization: Bearer (preferred), Authorization: Basic
# (i.e. http://remote:<token>@host/ — token in the password; http, NOT https: this
# server terminates no TLS, see README). Headers only — a token in the URL is
# refused (401) and would be written to the access log.
# (convenience; query strings can leak via proxy/access logs & browser history —
# avoid in prod).
APP_AUTH_TOKEN=
# Opt in to a non-loopback bind WITHOUT auth (e.g. a container behind -p on a
# trusted network). Leave empty unless you mean it.
APP_ALLOW_INSECURE_BIND=
# Dev only: auto-reload server on edits + browser livereload on restart.
APP_RELOAD=
# Detect and show each session's spawned subagents (default true). Set false to
# skip a /proc/<pid>/cmdline read per non-claude process on hosts with many procs.
APP_SHOW_AGENTS=
# Seconds one /proc snapshot is reused across callers (default 1.0). 0 or negative
# disables that reuse: every caller arriving after the previous walk finished gets
# a real walk of its own. Callers that arrive WHILE a walk is running still share
# its result at any TTL (one walk per burst, never one per caller) and are told its
# real age. Responses report their snapshot's age in `age_seconds`.
APP_SCAN_CACHE_TTL=
